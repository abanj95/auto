# Copy to .env.local and fill in real values. Never commit real keys.

# Supabase project URL (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=

# Publishable key (sb_publishable_…). Safe in the browser; RLS protects the data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret key (sb_secret_…). Server only: bypasses RLS. Never expose it.
SUPABASE_SECRET_KEY=

# Public site URL (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Let search engines index the site. Leave false until the real domain launches.
NEXT_PUBLIC_ALLOW_INDEXING=false

# Random string that Vercel Cron sends as "Authorization: Bearer …" (openssl rand -hex 24).
CRON_SECRET=
