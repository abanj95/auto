# Copy to .env.local and fill in. Never commit .env.local.
# Uses the new API keys (legacy anon/service_role keys are deprecated).

# Project URL: Project Settings → Data API (or the "Connect" button).
# Format: https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Keys: Project Settings → API Keys.
# Publishable key (sb_publishable_…) — safe in the browser; RLS protects data.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Secret key (sb_secret_…) — server-only, bypasses RLS. Never import in client
# code or prefix with NEXT_PUBLIC_. Browsers are rejected with 401.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public base URL (used for share links and metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
